# ===========================
# SpecSense – .gitignore
# ===========================

# Dependencies
node_modules/
.pnp
.pnp.js

# SQLite database (auto-generated by seed.js)
backend/database/*.sqlite
backend/database/*.sqlite-journal
backend/database/*.sqlite-shm
backend/database/*.sqlite-wal

# Frontend build output
frontend/dist/
frontend/dist-ssr/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# VS Code
.vscode/
!.vscode/extensions.json

# IDE
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temp / cache
.cache/
.temp/
tmp/
*.tmp
*.zip

# Coverage reports
coverage/
